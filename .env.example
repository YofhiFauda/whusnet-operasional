APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Isi dengan URL yang BENAR-BENAR dipakai pengguna. Di balik Cloudflare
# Tunnel itu berarti https://<subdomain>.trycloudflare.com atau domainmu —
# APP_URL dipakai membuat tautan dari queue/artisan yang tak punya request.
APP_URL=http://localhost

# ── HTTPS di balik proxy (Cloudflare Tunnel / nginx / ngrok) ──────────────
# Proxy yang boleh dipercaya header X-Forwarded-*-nya. '*' = percaya IP
# pemanggil langsung; aman selama PHP-FPM hanya bisa dicapai lewat nginx.
# Kalau app diekspos langsung ke internet, ganti dengan daftar IP proxy
# (dipisah koma).
TRUSTED_PROXIES=*

# Paksa skema https pada URL yang dibuat DI LUAR request (queue, artisan,
# notifikasi). Nyalakan hanya kalau aplikasi memang cuma dilayani via HTTPS.
FORCE_HTTPS=false

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Kosong/null = cookie ikut skema apa adanya (dev http tetap bisa login).
# Isi `true` HANYA kalau semua akses lewat https — kalau tidak, sesi hilang
# tiap request dan login berputar-putar tanpa pesan error.
SESSION_SECURE_COOKIE=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# ── Reverb (WebSocket) ────────────────────────────────────────────────────
# Lewat tunnel, browser menempuh wss://<host>/app/... dan nginx yang
# meneruskan ke container reverb — jadi VITE_REVERB_HOST/PORT/SCHEME cukup
# dibiarkan kosong: resources/js/echo.js otomatis memakai host, port, dan
# skema halaman yang sedang dibuka. Isi hanya kalau Reverb dilayani dari
# domain yang BERBEDA dengan aplikasinya.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# REVERB_HOST/PORT/SCHEME di bawah dipakai SISI SERVER (Laravel mendorong
# event ke Reverb), bukan browser — di Docker isinya nama service, bukan
# domain tunnel.
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jendela tagih kolektor — berapa hari SEBELUM jatuh tempo tagihan sudah
# muncul di Worklist Kolektor.
COLLECTOR_DUE_WINDOW_DAYS=7

# OCR cadangan kwitansi kolektor. Biarkan KOSONG kalau belum dipakai —
# pencocokan tetap jalan lewat QR, dan berkas yang gagal dibaca jatuh ke
# pencocokan manual admin. Tak ada biaya keluar selama kosong.
#
# JANGAN DIISI sebelum ADHOC-25 dikerjakan: hasil OCR saat ini langsung
# ditempelkan ke pembayaran, dan salah baca satu digit bisa membuat kwitansi
# menempel diam-diam ke pelanggan lain dengan status hijau "Cocok".
# docs/plan/kolektor/analisa-risiko-ocr-kwitansi.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# UID/GID pemilik repo di host. Dipakai service `assets` di docker-compose.yml
# (build Vite) supaya berkas hasil build di public/build tidak jadi milik root —
# kalau root, `npm run build` dari host gagal EACCES. Cek nilaimu: `id -u; id -g`.
HOST_UID=1000
HOST_GID=1000

# Webhook pemasangan (API 1, docs/api/) — tujuan hardcode, bukan tabel.
# WEBHOOK_WEBSITE_B_SECRET dipakai menandatangani (HMAC), plaintext, BUKAN
# di-hash — harus bisa dibaca ulang tiap kirim. Jangan commit nilai asli.
WEBHOOK_WEBSITE_B_URL=
WEBHOOK_WEBSITE_B_SECRET=

# Bot Telegram KHUSUS pihak luar — terpisah dari TELEGRAM_BOT_TOKEN/
# TELEGRAM_CHAT_ID (config/services.php) yang melayani notifikasi internal.
TELEGRAM_EXTERNAL_BOT_TOKEN=
TELEGRAM_EXTERNAL_CHAT_ID=

# API Baru (docs/api/api-pop-distribusi/) — arah MASUK, Website B yang connect
# ke sini. Dua token terpisah: baca topologi vs tulis assignment (kelas risiko
# beda, lihat keputusan.md §5). Jangan commit nilai asli.
POP_DISTRIBUSI_READ_TOKEN=
NETWORK_ASSIGNMENT_WRITE_TOKEN=

# API Portal Pelanggan (docs/api/api-portal-pelanggan/) — origin domain portal
# yang boleh CORS ke /api/customer-portal/*, dipakai config/cors.php. SPESIFIK,
# BUKAN wildcard (keputusan.md §1). Jangan commit nilai asli.
PORTAL_ALLOWED_ORIGIN=

# Client secret portal (Fase 2) — dicek header X-Portal-Client, lapis KEDUA
# di samping token per-pelanggan. Statis per environment. Jangan commit nilai
# asli.
PORTAL_CLIENT_SECRET=

# Webhook KELUAR ke portal (Fase 3) — event invoice.updated. BEDA dari
# PORTAL_CLIENT_SECRET di atas (itu arah MASUK, portal yang connect ke
# sini). Rotasi terpisah dari QR_HMAC_SECRET/APP_KEY. Jangan commit nilai
# asli.
PORTAL_WEBHOOK_URL=
PORTAL_WEBHOOK_SECRET=