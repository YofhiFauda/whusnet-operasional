# ═══════════════════════════════════════════════════════════════════════════
#  Template variabel produksi — Coolify
# ═══════════════════════════════════════════════════════════════════════════
#
# JANGAN commit `.env.production` beneran. File ini cuma DAFTAR variabel yang
# dibaca docker-compose.prod.yml (lihat `environment:` service `app`, jangkar
# `&app_env` dipakai ulang horizon/reverb/scheduler). Isi nilainya lewat tab
# "Environment Variables" di Coolify, satu per satu — BUKAN dengan upload file
# ini apa adanya.
#
# Variabel yang TIDAK ada di sini (SESSION_DRIVER, QUEUE_CONNECTION, dll)
# sudah di-hardcode ke nilai produksi di docker-compose.prod.yml sendiri —
# tidak perlu (dan tidak akan kebaca) diisi di sini.

# ── Wajib diisi ──────────────────────────────────────────────────────────
APP_NAME=Whusnet-Operasional
# Generate SEKALI dengan `php artisan key:generate --show`, simpan, jangan
# rotasi tanpa rencana (QR_HMAC_SECRET terpisah, tapi APP_KEY dipakai
# enkripsi session/cookie — rotasi = semua sesi login logout paksa).
APP_KEY=base64:GANTI_INI
# Domain publik SEBENARNYA (https://...), bukan localhost. Dipakai artisan/
# queue yang bikin URL tanpa request (notifikasi, link QR).
APP_URL=https://operasional.contoh.id
FORCE_HTTPS=true

# Database — pakai resource MySQL Coolify (managed) atau eksternal.
# db_password diisi otomatis kalau Coolify yang bikin resource-nya.
DB_HOST=
DB_PORT=3306
DB_DATABASE=whusnet_operasional
DB_USERNAME=
DB_PASSWORD=

# QR pelanggan (docs/plan/qr-code/) — HMAC payload QR, minimal 32 byte acak.
# `openssl rand -base64 32`. TERPISAH dari APP_KEY.
QR_HMAC_SECRET=

# WAJIB diisi — service `redis` di docker-compose.prod.yml SELALU jalan
# dengan `--requirepass`, kosong = AUTH gagal & seluruh container unhealthy.
# `openssl rand -base64 24`.
REDIS_PASSWORD=

# Reverb (WebSocket realtime) — REVERB_APP_ID/KEY/SECRET boleh string acak
# sendiri (bukan dari layanan luar), `openssl rand -hex 20`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ── Opsional, isi sesuai kebutuhan modul yang dipakai ───────────────────
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=


# Portal Pelanggan (Next.js terpisah) — WAJIB kalau fitur QR/portal aktif,
# domain publik/tunnel yang bisa dijangkau HP, bukan localhost.
PORTAL_BASE_URL=
PORTAL_ALLOWED_ORIGIN=
PORTAL_CLIENT_SECRET=
PORTAL_WEBHOOK_URL=
PORTAL_WEBHOOK_SECRET=

# Jendela tagih kolektor (hari sebelum jatuh tempo) — default 7 kalau kosong.
COLLECTOR_DUE_WINDOW_DAYS=7

# Notifikasi teknisi in-app (TelegramBotService). Kosong = notif Telegram
# internal nonaktif diam-diam, bukan error.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook keluar API 1 (docs/api/) — tujuan Website B & Telegram PIHAK LUAR.
# TERPISAH dari TELEGRAM_BOT_TOKEN/CHAT_ID di atas — jangan disamakan
# (config/webhooks.php: campur = notif internal nyasar ke grup luar).
WEBHOOK_WEBSITE_B_URL=
WEBHOOK_WEBSITE_B_SECRET=
TELEGRAM_EXTERNAL_BOT_TOKEN=
TELEGRAM_EXTERNAL_CHAT_ID=

# API masuk POP-distribusi (docs/api/api-pop-distribusi/) — Website B connect
# ke sini. Dua token terpisah: baca topologi vs tulis assignment.
POP_DISTRIBUSI_READ_TOKEN=
NETWORK_ASSIGNMENT_WRITE_TOKEN=

# ── Dibaca Coolify sendiri, bukan aplikasi ──────────────────────────────
# APP_VERSION menandai tag image whusnet-app di docker-compose.prod.yml.
# Biarkan `latest` kecuali sengaja mau pin versi tertentu.
APP_VERSION=latest
